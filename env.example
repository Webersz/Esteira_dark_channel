# Copy to `.env` and fill in:  cp env.example .env

# ===================== LLM =====================
# Free-tier limits are per Google Cloud PROJECT, not per key: create each key in a different project.
# Comma-separated pool; on 429/503 the next key is tried immediately. GEMINI_API_KEY (single) still works.
GEMINI_API_KEYS=key_project_1,key_project_2
GEMINI_API_KEY=
# Model cascade (in order). 404/429/503 skips to the next one instantly. Empty = built-in default
# (gemini-3.5-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3-flash-preview,
# gemini-3.5-flash-lite). Legacy GEMINI_MODEL is put first.
GEMINI_MODELS=

# Free OpenAI-compatible fallbacks, used only when every Gemini key/model fails. Leave empty to disable.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# GitHub fine-grained token with the "Models: read" permission
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Any other OpenAI-compatible /chat/completions endpoint
FALLBACK_LLM_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# ===================== Media =====================
# Optional: enables hybrid B-roll for channels with "use_broll": true
PEXELS_API_KEY=
# Optional: Pollinations token (higher rate limits). Leave empty for anonymous tier.
POLLINATIONS_TOKEN=
# Parallel image downloads (anonymous Pollinations tolerates ~2-3)
IMAGE_CONCURRENCY=3
# Parallel FFmpeg scene renders
RENDER_THREADS=2

# ===================== Whisper =====================
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# ===================== State / Queue =====================
POSTGRES_USER=factory
POSTGRES_PASSWORD=change_me
POSTGRES_DB=dark_factory
# Special characters in the password are URL-encoded automatically. If DATABASE_URL is empty it is
# built from POSTGRES_USER/PASSWORD/DB + POSTGRES_HOST (default localhost) and POSTGRES_PORT (5432).
DATABASE_URL=postgresql+psycopg2://factory:change_me@postgres:5432/dark_factory
REDIS_URL=redis://redis:6379/0
TZ=America/Sao_Paulo

# ===================== Alerts =====================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===================== Publishing =====================
# public | unlisted | private
YOUTUBE_PRIVACY=public
TIKTOK_HEADLESS=true
# Optional global proxy for TikTok (a channel's own "proxy" in channels_config.json wins)
TIKTOK_PROXY_SERVER=
TIKTOK_PROXY_USER=
TIKTOK_PROXY_PASS=
# true = render only, never publish (great for the first days)
DRY_RUN=false
# Delete working folders older than N days
KEEP_DAYS=3

# ===================== Paths (defaults are fine inside Docker) =====================
WORK_DIR=/app/output
MEDIA_DIR=/app/media_assets
CREDENTIALS_DIR=/app/credentials
